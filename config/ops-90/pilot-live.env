# OPS-90 — process env for local/staging
# Tenant overlay LIVE_RAILS is the source of truth (RailResolver).
# Do NOT copy config/tier-t7/production-trust.env onto the process.
#
# Demo tenant ten_dev_01: inherits these defaults (MOCK, MFA sandbox, simulate on).
# Pilot tenant ten_pilot_cdt_01: overlay paymentMethod=VNPAY, vnpaySandbox=true,
#   mfaSandbox=false, simulateEndpoints=false. Do not set WEREAL_ENV=staging here
#   unless WEBHOOK_SKIP_VERIFY=false and mock/complete is acceptable to 404.

NODE_ENV=development
# WEREAL_ENV=local
PAYMENT_DEFAULT_METHOD=MOCK
VNPAY_SANDBOX=true
MFA_SANDBOX=true
SMS_SANDBOX=true
ZALO_ZNS_SANDBOX=true
ESIGN_SANDBOX=true
EKYC_SANDBOX=true
SETTLEMENT_PAYOUT_ENABLED=false
ESCROW_BANK_PARTNER_ENABLED=false
BNPL_PARTNER_ENABLED=false
WEBHOOK_SKIP_VERIFY=false
WAU_PILOT_SIM_ENABLED=false

# Verify:
#   GET /admin/config/rails/resolved  X-Tenant-Id: ten_dev_01     → MOCK, mfaSandbox true
#   GET /admin/config/rails/resolved  X-Tenant-Id: ten_pilot_cdt_01 → VNPAY sandbox, mfaSandbox false,
#     znsSandbox false, smsSandbox false, pushLiveEnabled true (OPS-S4),
#     payoutStub false, payoutEnabled true, esignSandbox false (OPS-S5),
#     ssoOidcEnabled false (OPS-S6 optional SSO off)
# OPS-S6: GRAFANA_STAGING_URL + ONCALL_ROSTER on staging profile
PUSH_LIVE_ENABLED=false
GRAFANA_STAGING_URL=https://grafana.staging.wereal.vn

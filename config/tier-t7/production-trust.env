# Tier 7 — production trust superset (apply ON TOP of config/tier-b/production.env)
# Verify: ./scripts/uat-t7-money.sh + verify-production-flags --strict

# Platform
NODE_ENV=production
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
OTEL_ENABLED=true

# Identity (T7-S2)
MFA_SANDBOX=false
SSO_OIDC_USE_MOCK=false
AUTH_LOGIN_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_RATE_LIMIT_PER_MIN=10
AUTH_MFA_RATE_LIMIT_PER_MIN=20
STRICT_PRODUCTION_SECURITY=true
TLS_TERMINATED=true
TRUST_PROXY=true
CORS_ORIGINS=https://app.wereal.vn,https://staging.wereal.vn
# JWT_SECRET — set via secrets manager only, ≥32 chars

# Trust rails (T7-S4)
ESIGN_SANDBOX=false
EKYC_SANDBOX=false

# Money rails (T7-S5)
PAYMENT_DEFAULT_METHOD=VNPAY
VNPAY_SANDBOX=false
SETTLEMENT_PAYOUT_ENABLED=true
SETTLEMENT_PAYOUT_STUB=false
BANK_CONNECTOR_LIVE=true
REGULATORY_EXPORT_STUB=false
# REGULATORY_EXPORT_ENCRYPTION_KEY — secrets manager only, ≥32 chars
# SETTLEMENT_PAYOUT_URL / SETTLEMENT_PAYOUT_API_KEY — secrets manager
# BANK_WEBHOOK_SECRET — secrets manager
# VNPAY_TMN_CODE / VNPAY_HASH_SECRET / VNPAY_PAYMENT_URL — secrets manager
PAYMENT_ADAPTER=VNPay
ESCROW_BANK_PARTNER_ENABLED=true
WEBHOOK_SKIP_VERIFY=false

# Omnichannel live
ZALO_ZNS_SANDBOX=false
SMS_SANDBOX=false
META_GRAPH_SANDBOX=false

# Network prod (T7-S6)
WAU_PILOT_SIM_ENABLED=false
PUSH_LIVE_ENABLED=true

# Enterprise (T7-S8)
ERP_INVOICING_ENABLED=true
ERP_INVOICING_STUB=true
ENTERPRISE_PILOT_DOMAIN=portal.thanglong-dev.vn
REGION_ID=ap-southeast-1-hcm
DR_REGION_ID=ap-southeast-1-hn
MULTI_REGION_ENABLED=false

# Security
# JWT_SECRET — set via secrets manager only, ≥32 chars

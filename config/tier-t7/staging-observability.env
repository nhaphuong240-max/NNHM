# Tier 7 — staging observability (apply on top of tier-b staging)
# Apply: ./scripts/apply-tier-t7-observability.sh apps/api/.env

OTEL_ENABLED=true
OTEL_SERVICE_NAME=wereal-api-staging
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.25

PROMETHEUS_ENABLED=true
JSON_LOGS=true

SLO_AVAILABILITY_TARGET=99.5
API_P95_TARGET_MS=200
ONCALL_ROSTER=L1→Finance→TechLead
STATUS_PAGE_URL=https://status.wereal.internal
GRAFANA_ALERTS_ENABLED=true

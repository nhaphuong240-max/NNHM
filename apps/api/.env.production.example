# Production — Tier B live rails (no MOCK / no pilot stubs)
# Inject via secret manager — never commit apps/api/.env

NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://wereal:CHANGE_ME@prod-db:5432/wereal
REDIS_URL=redis://prod-redis:6379

JWT_SECRET=CHANGE_ME_ROTATE
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# Identity
MFA_SANDBOX=false
SSO_OIDC_USE_MOCK=false
SSO_OIDC_ENABLED=true
SSO_OIDC_CLIENT_SECRET=<from-idp>
# SSO_EMAIL_DOMAIN_ALLOWLIST=sunrise-dev.vn,wereal.vn

# Payment — production VNPay merchant
PAYMENT_DEFAULT_METHOD=VNPAY
VNPAY_TMN_CODE=<prod-merchant>
VNPAY_HASH_SECRET=<secret>
VNPAY_PAYMENT_URL=https://vnpayment.vn/paymentv2/vpcpay.html
WEBHOOK_HMAC_SECRET=<rotate>

# Omnichannel — live only
ZALO_ZNS_SANDBOX=false
SMS_SANDBOX=false
META_GRAPH_SANDBOX=false
ZALO_OA_ACCESS_TOKEN=<secret>
SMS_PROVIDER_URL=https://<sms-partner>/send
SMS_PROVIDER_API_KEY=<secret>

# Payout — real partner rail (no stub)
SETTLEMENT_PAYOUT_ENABLED=true
SETTLEMENT_PAYOUT_STUB=false
SETTLEMENT_PAYOUT_URL=https://<payout-partner>/batch
SETTLEMENT_PAYOUT_API_KEY=<secret>

# Tier 5
PUSH_LIVE_ENABLED=true
EXPO_ACCESS_TOKEN=<secret>
ESCROW_BANK_PARTNER_ENABLED=true
PARTNER_WEBHOOK_SECRET=<rotate>

# Trust
ESIGN_PROVIDER=VNPT_SMARTCA
ESIGN_SANDBOX=false
ESIGN_WEBHOOK_SECRET=<secret>
EKYC_PROVIDER=VNPT_EKYC
EKYC_SANDBOX=false

BNPL_PARTNER_ENABLED=true
BNPL_PARTNER_URL=https://<bnpl-partner>/bnpl
BNPL_PARTNER_API_KEY=<secret>

# Ops
SLO_AVAILABILITY_TARGET=99.5
PROMETHEUS_ENABLED=true
SCHEDULE_LEADER_ENABLED=true
API_P95_TARGET_MS=200
# OTEL_ENABLED=true

# Production — pilot sim OFF
WAU_PILOT_SIM_ENABLED=false

# Copy to .env — S1 local dev
PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://wereal:wereal@localhost:5432/wereal
REDIS_URL=redis://localhost:6379

# T7-S1 — schema (dev: synchronize on; prod: migrations only)
# DB_SYNCHRONIZE=true
# DB_MIGRATIONS_RUN=false

# T7-S2 — security (dev: sandbox MFA/SSO; prod: see config/tier-t7/production-trust.env)
# MFA_SANDBOX=true
# AUTH_LOGIN_RATE_LIMIT_ENABLED=true
# AUTH_LOGIN_RATE_LIMIT_PER_MIN=10
# CORS_ORIGINS=http://localhost:5174,http://localhost:5173

# T7-S3 — observability (staging: ./scripts/apply-tier-t7-observability.sh)
# OTEL_ENABLED=true
# PROMETHEUS_ENABLED=true

# Booking lock TTL follows reservation expiry (S3-01); expiry job every 1 min (S3-02 / BR-17)

# Payment — S4-01 ADR-004 (MOCK default in dev; set VNPAY for sandbox redirect)
PAYMENT_DEFAULT_METHOD=MOCK
PAYMENT_INTENT_TTL_MINUTES=15
VNPAY_SANDBOX=true
VNPAY_TMN_CODE=WEREALDEV
VNPAY_HASH_SECRET=wereal-dev-vnpay-secret-change-me
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Webhook — S4-02 BR-21 idempotent (Redis 7d + Postgres unique eventId)
WEBHOOK_HMAC_SECRET=wereal-dev-webhook-secret-change-me
WEBHOOK_IDEMPOTENCY_TTL_SECONDS=604800
# WEBHOOK_SKIP_VERIFY=true   # local only — ignored (fail) when WEREAL_ENV=staging|prod
# WEREAL_ENV=local

# Default tenant when X-Tenant-Id header omitted (dev only)
DEFAULT_TENANT_ID=ten_dev_01

# Zalo OA / ZNS — UC-NW-01 (sandbox default; set false for Graph API live)
ZALO_APP_ID=zalo_app_dev
# ZALO_OA_SECRET=
# ZALO_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/integrations/zalo/oauth/callback
# ZALO_OAUTH_SUCCESS_URL=http://localhost:5174/admin/integrations/zalo
# ZALO_OA_ACCESS_TOKEN=
# ZALO_OA_REFRESH_TOKEN=
# ZALO_WEBHOOK_SKIP_SIGNATURE=true
ZALO_ZNS_SANDBOX=true
ZALO_PAYMENT_ZNS_ENABLED=true

# SMS Gateway — UC-NW-03 (sandbox default; OTP hook on payment intent)
SMS_SANDBOX=true
SMS_PAYMENT_OTP_ENABLED=true
SMS_PAYMENT_SUCCESS_ENABLED=true

# Document Vault — UC-TR-02 (local disk pilot; swap to s3 when MinIO/S3 ready)
DOCUMENTS_STORAGE=local
DOCUMENTS_LOCAL_ROOT=./uploads
# DOCUMENTS_S3_BUCKET=wereal-documents-dev
# DOCUMENTS_S3_ENDPOINT=http://localhost:9000

# JWT — S1-02 UC-ID-03 (change JWT_SECRET in production)
JWT_SECRET=wereal-dev-jwt-secret-change-me
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# MFA step-up — UC-ID-03 (P3-S6: TOTP when false)
MFA_SANDBOX=true

# OPS-S1 — tenant LIVE_RAILS overlay (tenant > env). See config/ops-90/pilot-live.env
# GET/PATCH /admin/config/rails · GET /admin/config/rails/resolved

# SSO OIDC — UC-ID-06 production (Wave L)
SSO_OIDC_ENABLED=true
SSO_OIDC_USE_MOCK=true
SSO_OIDC_CALLBACK_URL=http://localhost:5174/auth/sso/callback
SSO_OIDC_API_CALLBACK_URL=http://localhost:3000/api/v1/auth/sso/callback
# SSO_OIDC_CLIENT_SECRET=   # required when SSO_OIDC_USE_MOCK=false

# AI Reply LLM — UC-AI-04 (Wave L)
AI_REPLY_ENABLED=true
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_REPLY_MODEL=gpt-4o-mini

# BNPL partner — UC-PAY-07 (T4-S4 staging: set true + sandbox URL)
BNPL_PARTNER_ENABLED=false
# Staging: BNPL_PARTNER_ENABLED=true
# BNPL_PARTNER_URL=https://partner.example/bnpl
# BNPL_PARTNER_API_KEY=
# BNPL_WEBHOOK_SECRET=

# Zalo inbox template (CRM unified inbox)
# ZALO_INBOX_TEMPLATE_ID=inbox_reply

# Meta Lead Ads — UC-NW-02 (Phase 2)
META_VERIFY_TOKEN=wereal-meta-verify-dev
# META_APP_ID=
# META_APP_SECRET=
# META_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/integrations/meta/oauth/callback
# META_OAUTH_SUCCESS_URL=http://localhost:5174/admin/integrations/meta
# META_WEBHOOK_SKIP_SIGNATURE=true
# META_GRAPH_SANDBOX=true
# META_PAGE_ACCESS_TOKEN=
# META_GRAPH_API_BASE=https://graph.facebook.com/v21.0

# SMS provider live — UC-NW-03 (Phase 2)
# SMS_PROVIDER_STUB=true               # pilot: live OTP path without external URL
# SMS_PROVIDER_URL=https://sms-provider.example/send
# SMS_PROVIDER_API_KEY=

# Settlement payout rail — UC-PAY-04 (Phase 2)
SETTLEMENT_PAYOUT_ENABLED=false
# Staging live: SETTLEMENT_PAYOUT_ENABLED=true SETTLEMENT_PAYOUT_STUB=true
# SETTLEMENT_PAYOUT_STUB=true          # pilot: SUBMITTED without partner URL
# SETTLEMENT_PAYOUT_URL=https://payout-partner.example/batch
# SETTLEMENT_PAYOUT_API_KEY=

# Tier 5 — Agent push + NHNN escrow (enable via Tier B live rails)
# See docs/dev/tier-b-live-rails.md · config/tier-b/*.env
PUSH_LIVE_ENABLED=false
# PUSH_LIVE_ENABLED=true               # staging/prod Tier B
# EXPO_ACCESS_TOKEN=
ESCROW_BANK_PARTNER_ENABLED=false
# ESCROW_BANK_PARTNER_ENABLED=true
PARTNER_WEBHOOK_SECRET=wereal_partner_stub_secret
# WAU_PILOT_SIM_ENABLED=true           # staging only — POST /analytics/agent/wau/simulate

# Reconcile MISMATCH ops alert — P3-S3-03
# OPS_ALERT_EMAIL=finance-ops@sunrise-dev.vn
# OPS_RECONCILE_WEBHOOK_URL=https://hooks.example.com/reconcile

# Tier 2 — Config platform (T2-S1/S6)
CONFIG_PLATFORM_READ=dual
CONFIG_PLATFORM_WRITE=dual

# Tier 2 — eKYC VN (T2-S4)
EKYC_PROVIDER=VNPT_EKYC
EKYC_SANDBOX=true
# EKYC_VERIFICATION_BASE_URL=http://localhost:5174/admin/kyc/verify

# Tier 2 — E-sign legal provider (T2-S5)
# WEREAL_ESIGN_STUB=false
ESIGN_PROVIDER=VNPT_SMARTCA
ESIGN_SANDBOX=true
# ESIGN_SIGNING_BASE_URL=http://localhost:5174/buyer/esign
# ESIGN_WEBHOOK_SECRET=wereal-esign-dev-secret
# ESIGN_WEBHOOK_SKIP_VERIFY=true

# Tier 2 — SSO prod hardening (T2-S3)
# SSO_OIDC_USE_MOCK=false
# SSO_EMAIL_DOMAIN_ALLOWLIST=sunrise-dev.vn,wereal.vn

# Tier 2 — Ops SLA 99.5% (T2-S6)
SLO_AVAILABILITY_TARGET=99.5
ONCALL_ROSTER=L1-Platform→L2-Finance→L3-TechLead
# STATUS_PAGE_URL=https://status.wereal.internal
# PAGERDUTY_SERVICE_KEY=

# Tier 3 — Scale (K8s · OTel · perf)
SCHEDULE_LEADER_ENABLED=true
PROMETHEUS_ENABLED=true
# OTEL_ENABLED=true
# OTEL_SERVICE_NAME=wereal-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
API_P95_TARGET_MS=200
# JSON_LOGS=true

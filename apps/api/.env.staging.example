# Staging — Tier B live rails (full template)
# 1. cp apps/api/.env.staging.example apps/api/.env
# 2. Set secrets below + DATABASE_URL for your host
# 3. ./scripts/verify-production-flags.sh --profile staging --strict apps/api/.env
# 4. ./scripts/uat-tier-b-rails.sh http://localhost:3000/api/v1

NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://wereal:CHANGE_ME@staging-db:5432/wereal
REDIS_URL=redis://staging-redis:6379

JWT_SECRET=CHANGE_ME_ROTATE
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
DEFAULT_TENANT_ID=ten_dev_01

# Identity — Tier A
MFA_SANDBOX=false
SSO_OIDC_USE_MOCK=false
SSO_OIDC_ENABLED=true
# SSO_OIDC_CLIENT_SECRET=<from-idp>

# Payment — VNPay sandbox merchant
PAYMENT_DEFAULT_METHOD=VNPAY
VNPAY_TMN_CODE=<staging-merchant>
VNPAY_HASH_SECRET=<secret>
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
WEBHOOK_HMAC_SECRET=<rotate>

# Omnichannel — live paths (partner creds required for real send)
ZALO_ZNS_SANDBOX=false
SMS_SANDBOX=false
META_GRAPH_SANDBOX=false
# ZALO_OA_ACCESS_TOKEN=
# SMS_PROVIDER_URL=
# SMS_PROVIDER_API_KEY=

# Commission / payout — OP-WIN-06 (stub proves SUBMITTED without partner)
SETTLEMENT_PAYOUT_ENABLED=true
SETTLEMENT_PAYOUT_STUB=true
# SETTLEMENT_PAYOUT_URL=https://payout-partner.example/batch
# SETTLEMENT_PAYOUT_API_KEY=

# Tier 5 — mobile push + NHNN escrow
PUSH_LIVE_ENABLED=true
# EXPO_ACCESS_TOKEN=
ESCROW_BANK_PARTNER_ENABLED=true
PARTNER_WEBHOOK_SECRET=wereal-staging-partner-secret

# E-sign + eKYC — VN legal providers
ESIGN_PROVIDER=VNPT_SMARTCA
ESIGN_SANDBOX=false
# ESIGN_WEBHOOK_SECRET=
EKYC_PROVIDER=VNPT_EKYC
EKYC_SANDBOX=false

# BNPL pilot
BNPL_PARTNER_ENABLED=true
# BNPL_PARTNER_URL=

# Ops SLA
SLO_AVAILABILITY_TARGET=99.5
PROMETHEUS_ENABLED=true
SCHEDULE_LEADER_ENABLED=true
API_P95_TARGET_MS=200

# Staging-only GTM (disable in production)
WAU_PILOT_SIM_ENABLED=true

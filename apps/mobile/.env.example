# API base — bắt buộc reachable từ thiết bị thật khi EAS preview (không dùng localhost)
# Dev LAN: http://192.168.x.x:3000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# EAS Build (G2.4) — lấy sau `npx eas init`
# EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# EXPO_TOKEN=... (chỉ dùng local/CI, không commit)
